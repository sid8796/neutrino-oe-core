#!/bin/sh
case "${1:-}" in
start) exec start-stop-daemon -S -x /usr/bin/oscam-emu -- --config-dir /var/tuxbox/config/oscam-emu --daemon --pidfile /var/run/oscam-emu.pid ;;
stop) exec start-stop-daemon -K -o -R TERM/5/KILL/2 -x /usr/bin/oscam-emu ;;
restart) "$0" stop; "$0" start ;;
*) echo "Usage: $0 start|stop|restart" >&2; exit 2 ;;
esac
